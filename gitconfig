[user]
    name = Petter Nyström
[log]
    decorate = short
[push]
    default = simple
[core]
    editor = vim
    autocrlf = input
    eol = lf
    pager = "sh -c 'cols=${COLUMNS:-$(tput cols 2>/dev/null || printf 0)}; case \"$cols\" in \"\"|*[!0-9]*) cols=0;; esac; if [ \"$cols\" -gt 100 ]; then exec delta -s; else exec delta; fi'"
[interactive]
    diffFilter = delta --color-only
[delta]
    dark = true
    syntax-theme = TwoDark
    navigate = true
    line-numbers = true
    zero-style = syntax
    minus-style = "#FF7B72 #3d1f1f"
    minus-emph-style = "#FFFFFF bold #8e2b2b"
    plus-style = "#7EE787 #1c3a24"
    plus-emph-style = "#FFFFFF bold #1f7a3a"
    file-style = "#79C0FF bold"
    hunk-header-style = "#56D4DD"
    line-numbers-zero-style = "#9AA5B1"
    line-numbers-minus-style = "#FF7B72"
    line-numbers-plus-style = "#7EE787"
[alias]
    co = checkout
    cb = checkout -b
    ci = commit
    ca = commit --amend
    cf = commit --fixup
    st = status
    br = branch
    ff = merge --ff-only
    lag = log --all --graph
    pushorigin = push -u origin HEAD
    force = push --force-with-lease
    pr = "!f() { git --no-pager log --pretty='format:* %s%n%n%b' origin..HEAD|sed 's/^\\([^*]\\)/    \\1/'|pbcopy && pbpaste; }; f"
    tag-for-release = "!f() { git tag -a `date +v%Y.%m.%d` -m `date +v%Y.%m.%d`; }; f"
    ed = "!nvim $(git status --porcelain | grep -E '^(M| )?(M|A) ' | awk '{ print $2 }')"
[diff]
    algorithm = patience
    context = 15
[color]
    diff = auto
    status = auto
    branch = auto
    interactive = auto
    ui = true
    pager = true
[gitreview]
    username = pnystro4
    remote = origin
    track = true
